# Copy to .env and fill in. Never commit .env.

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
# Auth endpoints per IP per minute (raise for local e2e runs)
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Persistence -----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://notely:notely@localhost:5432/notely
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=notely

# --- Secrets (required in production) ----------------------------------------------
# Any long random string; keys the session token hashes.
SESSION_SECRET=change-me-to-a-long-random-string
# Fernet key for provider credentials at rest. Generate: cd apps/api && uv run python -m app.core.crypto
ENCRYPTION_KEY=

# --- Production hardening (Phase 7) --------------------------------------------------
# Bearer token Prometheus presents on GET /metrics (mandatory when ENVIRONMENT=production).
METRICS_TOKEN=
# Only true when the API sits behind a proxy that sets X-Forwarded-For (IP rate limits).
TRUST_PROXY_HEADERS=false
# Bake HSTS + upgrade-insecure-requests into the web app (TLS deployments only).
WEB_SECURE=false
# Directory with fullchain.pem/privkey.pem for the nginx edge (docker-compose.prod.yml).
TLS_CERT_DIR=./infra/nginx/certs

# --- Web / API origins -------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Where Next.js reaches FastAPI server-side (inside compose: http://api:8000)
API_INTERNAL_URL=http://localhost:8000

# --- AI ------------------------------------------------------------------------------
# litellm = real models through the gateway (needs a provider key below).
# fake    = scripted replies for tests/offline dev; refused in production.
AI_PROVIDER=litellm
AI_MODEL_DEFAULT=notely-default
AI_MODEL_FAST=notely-fast
# postgres persists paused (approval-pending) runs; memory is for tests only.
AI_CHECKPOINTER=postgres

# --- LLM gateway -------------------------------------------------------------------
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-notely-dev
LITELLM_MASTER_KEY=sk-notely-dev
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Notely sign-in providers (optional; enabled only when both values are set) -------
# "Continue with Google/Microsoft" shares the vendor app AND the redirect URI with the
# matching connectors: {FRONTEND_ORIGIN}/api/v1/oauth/google/callback (see docs/oauth-setup.md).
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common

# --- Integration providers (Phase 5) -----------------------------------------------
# A provider appears as "available" in the marketplace only when both values are set.
# Redirect URI to register with each vendor: {FRONTEND_ORIGIN}/api/v1/oauth/{vendor}/callback
#   e.g. http://localhost:3000/api/v1/oauth/google/callback (Gmail + Calendar + Drive share it),
#        http://localhost:3000/api/v1/oauth/microsoft/callback (Teams + Outlook + OneDrive).
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=
OAUTH_NOTION_CLIENT_ID=
OAUTH_NOTION_CLIENT_SECRET=
OAUTH_TODOIST_CLIENT_ID=
OAUTH_TODOIST_CLIENT_SECRET=
OAUTH_ASANA_CLIENT_ID=
OAUTH_ASANA_CLIENT_SECRET=
OAUTH_JIRA_CLIENT_ID=
OAUTH_JIRA_CLIENT_SECRET=
OAUTH_DROPBOX_CLIENT_ID=
OAUTH_DROPBOX_CLIENT_SECRET=
OAUTH_CLICKUP_CLIENT_ID=
OAUTH_CLICKUP_CLIENT_SECRET=
# Gmail, Google Calendar and Google Drive reuse OAUTH_GOOGLE_CLIENT_ID/SECRET (enable the Gmail,
# Calendar and Drive APIs on that Google Cloud project). Notion, Jira, ClickUp, Stripe and PayPal
# also work with no app at all through their official MCP servers (dynamic client registration).
