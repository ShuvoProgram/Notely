# Copy to .env and fill in. Never commit .env.

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
# Auth endpoints per IP per minute (raise for local e2e runs)
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Persistence -----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://notely:notely@localhost:5432/notely
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=notely

# --- Secrets (required in production) ----------------------------------------------
# Any long random string; keys the session token hashes.
SESSION_SECRET=change-me-to-a-long-random-string
# Fernet key for provider credentials at rest. Generate: cd apps/api && uv run python -m app.core.crypto
ENCRYPTION_KEY=

# --- Web / API origins -------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Where Next.js reaches FastAPI server-side (inside compose: http://api:8000)
API_INTERNAL_URL=http://localhost:8000

# --- AI ------------------------------------------------------------------------------
# litellm = real models through the gateway (needs a provider key below).
# fake    = scripted replies for tests/offline dev; refused in production.
AI_PROVIDER=litellm
AI_MODEL_DEFAULT=notely-default
AI_MODEL_FAST=notely-fast
# postgres persists paused (approval-pending) runs; memory is for tests only.
AI_CHECKPOINTER=postgres

# --- LLM gateway -------------------------------------------------------------------
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-notely-dev
LITELLM_MASTER_KEY=sk-notely-dev
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Notely sign-in providers (optional; enabled only when both values are set) -------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common

# --- Integration providers (Phase 4+) ---------------------------------------------
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=
OAUTH_NOTION_CLIENT_ID=
OAUTH_NOTION_CLIENT_SECRET=
